# ==============================================================================
# IoT Solar Dryer with PCM Thermal Storage - Environment Configuration
# ==============================================================================

# ESP32 Device Authentication (Required)
# Must match API_KEY in firmware/esp32_solar_dryer/config.h.
# Rotate this key in Vercel and re-flash the ESP32.
DEVICE_API_KEY="replace_with_a_secure_random_device_api_key_for_esp32"

# Administrator Passcode (Required for Settings, Buzzer Test, and Admin Write Operations)
ADMIN_PASSCODE="replace_with_a_strong_admin_passcode"

# Session HMAC Signing Secret (Required for server-side httpOnly auth cookie)
SESSION_SECRET="replace_with_a_secure_random_64_character_session_signing_secret"

# Public App URL (Used for generating real ingestion and config endpoint links)
NEXT_PUBLIC_APP_URL="https://pcm-six.vercel.app"

# Default Device Identifier
DEFAULT_DEVICE_ID="solar-dryer-01"

# Demo Mode Disabled (Strictly false: never add fake or demo data)
NEXT_PUBLIC_ENABLE_DEMO_MODE="false"

# Supabase PostgreSQL Database (Required for persistent telemetry, RLS, and configurations)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key-with-read-only-access"
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key-never-exposed-to-client"
