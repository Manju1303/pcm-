# ==============================================================================
# Solar Dryer IoT Dashboard - Environment Configuration
# ==============================================================================

# Ingestion API Key (Must match API_KEY in firmware config.h)
API_INGEST_KEY="sd_secret_key_college_dryer_2026"

# Default Device Identifier
DEFAULT_DEVICE_ID="solar-dryer-01"

# Demo Mode Enabled by Default (true/false)
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"

# Supabase PostgreSQL Configuration (Optional - dashboard runs with built-in storage if omitted)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Admin Access Passcode for protected threshold settings
ADMIN_PASSCODE="admin2026"
